# =====================================================================
# DMC eQMS – Backend (Laravel 11) – mẫu cấu hình môi trường
# Copy file này thành `.env` rồi chạy: php artisan key:generate
# KHÔNG commit `.env` thật; KHÔNG đặt secret thật vào `.env.example`.
# =====================================================================

APP_NAME="DMC eQMS"
APP_ENV=local
# Sinh bằng: php artisan key:generate (mỗi máy một key riêng)
APP_KEY=
APP_DEBUG=true
# Timezone nghiệp vụ theo trụ sở DMC (Việt Nam)
APP_TIMEZONE=Asia/Ho_Chi_Minh
APP_URL=http://127.0.0.1:8000

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Dev dùng MySQL 8 (Laragon). Lên production đổi sang pgsql + cài extension pdo_pgsql.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eqms
DB_USERNAME=root
# Mật khẩu MySQL local (Laragon mặc định: để trống). Production: đặt giá trị riêng, KHÔNG commit.
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="eqms@dmc.vn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Origin Frontend (Vite dev server) – dùng cho CORS (config/cors.php).
# Production: đổi thành domain FE thật, KHÔNG dùng wildcard.
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"
