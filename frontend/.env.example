# DMC eQMS frontend – cấu hình môi trường
# Copy file này thành `.env` rồi chỉnh giá trị cho máy bạn.
# KHÔNG đặt secret (password/private key) vào biến VITE_* – chúng được nhúng vào bundle JS khi build.

# Origin của Laravel API (vd: http://127.0.0.1:8000 hoặc https://eqms-api.example.com).
# Bỏ TRỐNG nếu frontend chạy sau Vite proxy (xem vite.config.ts – biến VITE_PROXY_TARGET).
VITE_API_URL=http://127.0.0.1:8000

# 'true' = dùng mock API (in-memory, không cần backend) cho development/test nhanh.
# 'false' (hoặc bỏ trống) = gọi API Laravel THẬT. KHÔNG fallback âm thầm sang mock khi API lỗi.
VITE_USE_MOCK=false

# (Tùy chọn, dev only) Target cho Vite dev-server proxy '/api' khi VITE_API_URL để trống.
VITE_PROXY_TARGET=http://127.0.0.1:8000
