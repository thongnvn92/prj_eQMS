# DMC eQMS frontend – cấu hình cho DEVELOPMENT (`npm run dev`, `vite build --mode development`).
# Vite ưu tiên file này hơn `.env` khi chạy mode development.
# KHÔNG đặt secret vào biến VITE_* – chúng được nhúng vào bundle JS khi build.

# Backend Laravel (dev): php artisan serve hoặc Laragon vhost trỏ cổng 8000.
VITE_API_URL=http://127.0.0.1:8000

# false = gọi API Laravel thật (mặc định dev). true = mock in-memory khi không muốn chạy BE.
VITE_USE_MOCK=false

# (Tùy chọn) Dev-server proxy '/api' – chỉ dùng khi để VITE_API_URL trống.
VITE_PROXY_TARGET=http://127.0.0.1:8000
